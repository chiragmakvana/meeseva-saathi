# Copy to .env and adjust. Never commit .env.
DATABASE_URL=sqlite:///./meeseva_saathi.db
# Long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Show the OTP on screen because no SMS gateway is connected in the prototype
DEMO_OTP_MODE=true

# Optional: Azure OpenAI. Leave empty to use the built-in rules engine.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
